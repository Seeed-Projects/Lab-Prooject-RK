# Repository layout (normally auto-detected)
# RETAIL_AI_ROOT=/opt/recomputer-rk3588-retail-ai-suite

# Web application
DEMO_HUB_HOST=0.0.0.0
DEMO_HUB_PORT=8080

# reCamera
RECAMERA_IP=192.168.42.1
RECAMERA_RTSP_URL=rtsp://192.168.42.1:8554/detected
RECAMERA_WS_URL=ws://192.168.42.1:9002

# Local intent and summary model
LLM_SUMMARY_URL=http://127.0.0.1:8001
RKLLM_MODEL=rkllm-model

# Voice capture and ASR
CARD=Array
ASR_URL=http://127.0.0.1:8621
VOICE_IMAGE=openvoicestream:asr-realtime

# Piper Amy low and ES8311 3.5 mm output
# PIPER_BIN and PIPER_MODEL default to files under models/piper.
PIPER_SINK=alsa_output.platform-es8311-sound.stereo-fallback
PIPER_LENGTH_SCALE=1.12
PIPER_PLAYER_BIN=paplay

# Optional RTSP-to-WebRTC bridge; MJPEG remains the fallback.
# GO2RTC_BIN=/usr/local/bin/go2rtc
GO2RTC_API_URL=http://127.0.0.1:1984

# Multi-camera tuning
MULTI_CAPTURE_FPS=20.0
MULTI_INFERENCE_FPS=15.0
MULTI_DISPLAY_FPS=20.0
